# === LLM Configuration ===
# Set ONE of these API keys (Groq is recommended for ultra-low latency & open models):
GROQ_API_KEY=your-groq-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model name:
# For Groq: openai/gpt-oss-120b (recommended), openai/gpt-oss-20b
# For Gemini: gemini-2.0-flash, gemini-2.5-pro
# For Anthropic: claude-3-5-sonnet-20241022
LLM_MODEL=openai/gpt-oss-120b

# === Demo Mode ===
# Set to 1 to serve pre-computed responses for bundled sample documents.
# Non-sample uploads will show a warning and process normally.
DEMO_MODE=0

# === App Settings ===
DATABASE_URL=sqlite:///./nyayalens.db
SESSION_EXPIRY_HOURS=24
MAX_CONCURRENT_LLM_CALLS=4

# === Note ===
# Only use synthetic/sample documents with free-tier API keys.
# Free-tier keys have rate limits that may cause timeouts on large documents.
